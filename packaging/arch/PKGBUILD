# Maintainer: donno <donno@donno.de>
pkgname=linexus
pkgver=1.0.0
pkgrel=1
pkgdesc='Daemon and web configurator for the Corsair iCUE Nexus touch strip'
arch=('x86_64' 'aarch64')
url='https://github.com/demoriaan/linexus'
license=('MIT')
install="${pkgname}.install"
depends=('systemd-libs' 'gcc-libs' 'glibc')
makedepends=('cargo')
# makepkg's LTO flags turn the bundled C crypto library into GCC bitcode
# that the Rust linker cannot read.
options=('!lto')
optdepends=(
  'wireplumber: volume control and volume widgets (wpctl)'
  'curl: feeds, weather, Home Assistant and web request actions'
  'xdg-utils: opening links and launching applications'
  'upower: battery levels of wireless mice, keyboards and headsets'
  'rocm-smi-lib: AMD GPU readings where sysfs does not provide them'
)
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  cargo build --release --locked -p nexusctl -p nexus-daemon -p nexus-inputd -p nexus-studio
}

check() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  cargo test --release --locked --workspace
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 target/release/linexusctl "${pkgdir}/usr/bin/linexusctl"
  install -Dm755 target/release/linexusd "${pkgdir}/usr/bin/linexusd"
  install -Dm755 target/release/linexus-studio "${pkgdir}/usr/bin/linexus-studio"
  install -Dm755 target/release/linexus-inputd "${pkgdir}/usr/lib/linexus/linexus-inputd"

  install -Dm644 packaging/udev/99-linexus.rules "${pkgdir}/usr/lib/udev/rules.d/99-linexus.rules"
  install -Dm644 packaging/systemd/user/linexusd.service "${pkgdir}/usr/lib/systemd/user/linexusd.service"
  install -Dm644 packaging/systemd/user/linexus-inputd.service "${pkgdir}/usr/lib/systemd/user/linexus-inputd.service"
  install -Dm644 packaging/systemd/system/linexus-inputd.service "${pkgdir}/usr/lib/systemd/system/linexus-inputd@.service"
  sed -i 's#%h/.local/bin/linexusd#/usr/bin/linexusd#' "${pkgdir}/usr/lib/systemd/user/linexusd.service"
  sed -i 's#%h/.local/bin/linexus-inputd#/usr/lib/linexus/linexus-inputd#; s#file:%h/.local/share/doc/linexus/#file:/usr/share/doc/linexus/#' \
    "${pkgdir}/usr/lib/systemd/user/linexus-inputd.service"
  sed -i 's#/usr/local/lib/linexus/linexus-inputd#/usr/lib/linexus/linexus-inputd#; s/--allow-uid 1000/--allow-uid %i/' \
    "${pkgdir}/usr/lib/systemd/system/linexus-inputd@.service"

  install -Dm644 packaging/desktop/io.github.demoriaan.linexus.desktop "${pkgdir}/usr/share/applications/io.github.demoriaan.linexus.desktop"
  (cd packaging/icons/hicolor && find . -type f -exec install -Dm644 {} "${pkgdir}/usr/share/icons/hicolor/{}" \;)

  install -Dm644 README.md "${pkgdir}/usr/share/doc/linexus/README.md"
  install -Dm644 docs/*.md -t "${pkgdir}/usr/share/doc/linexus/"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  local licenses="${pkgdir}/usr/share/licenses/${pkgname}"
  install -Dm644 THIRD-PARTY-NOTICES.md "${licenses}/THIRD-PARTY-NOTICES.md"
  install -Dm644 crates/nexus-render/assets/fonts/OFL.txt "${licenses}/OFL-Barlow.txt"
  install -Dm644 crates/nexus-render/src/font_headline.OFL.txt "${licenses}/OFL-Terminus.txt"
  install -Dm644 crates/nexus-render/assets/icons/LICENSE "${licenses}/ISC-Lucide.txt"
  install -Dm644 apps/nexus-studio/fonts/LICENSE-Inter.txt "${licenses}/OFL-Inter.txt"
  install -Dm644 apps/nexus-studio/vendor/LICENSES.md "${licenses}/web-libraries.md"
}
