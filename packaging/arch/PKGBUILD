# Maintainer: donno <donno@donno.de>
pkgname=linexus
pkgver=1.3.0
pkgrel=1
pkgdesc='Daemon and web configurator for the Corsair iCUE Nexus touch strip'
arch=('x86_64' 'aarch64')
url='https://github.com/demoriaan/linexus'
license=('MIT')
install="${pkgname}.install"
depends=('systemd-libs' 'gcc-libs' 'glibc')
makedepends=('cargo')
# makepkg's LTO flags turn the bundled C crypto library into GCC bitcode
# that the Rust linker cannot read.
options=('!lto')
optdepends=(
  'wireplumber: volume control and volume widgets (wpctl)'
  'curl: feeds, weather, Home Assistant and web request actions'
  'xdg-utils: opening links and launching applications'
  'upower: battery levels of wireless mice, keyboards and headsets'
  'rocm-smi-lib: AMD GPU readings where sysfs does not provide them'
  'nvidia-utils: NVIDIA GPU readings (nvidia-smi)'
)
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  cargo build --release --locked -p nexusctl -p nexus-daemon -p nexus-inputd -p nexus-studio
}

check() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  cargo test --release --locked --workspace
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  packaging/scripts/stage-root.sh target/release "${pkgdir}"
}
