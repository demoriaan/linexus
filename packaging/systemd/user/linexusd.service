[Unit]
Description=Linexus daemon for the Corsair iCUE Nexus
Documentation=https://github.com/demoriaan/linexus
After=graphical-session.target dbus.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/linexusd
Restart=on-failure
RestartSec=2s

[Install]
# default.target starts it with the user manager; graphical-session.target
# starts it again at the next login when the user manager stayed up
# (lingering), after PartOf= stopped it at logout.
WantedBy=default.target graphical-session.target
